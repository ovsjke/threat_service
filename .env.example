DB_USER=kaspersky
DB_PASSWORD=supersecret
DB_HOST=db
DB_PORT=5432
DB_NAME=mydatabase
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable
API_URL=https://localhost

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
API_HTTP_HOST_PORT=8080
API_GRPC_HOST_PORT=50051
SCANNER_HTTP_PORT=8082
TEST_DB_PORT=5433
E2E_HOST_PORT=8081
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_local_password
PROMETHEUS_RETENTION=24h

SCANNER_MAX_FILE_BYTES=10485760
SCANNER_MAX_CONCURRENT=4
SCANNER_SCAN_TIMEOUT=60s
CLAMAV_DIAL_TIMEOUT=3s
CLAMAV_TIMEOUT=60s
SCANNER_SHUTDOWN_TIMEOUT=15s
SCANNER_READ_HEADER_TIMEOUT=5s
SCANNER_IDLE_TIMEOUT=60s
SCANNER_STOP_GRACE_PERIOD=20s

REDIS_ADDR=redis:6379
REDIS_MAXMEMORY=128mb
THREAT_CACHE_ENABLED=true
THREAT_CACHE_TTL=10m

SCANNER_CACHE_ENABLED=true
SCANNER_CACHE_TTL=1h
SCANNER_CACHE_REDIS_TIMEOUT=80ms
SCANNER_CACHE_POLICY_VERSION=v1

SCANNER_CACHE_VERSION_TIMEOUT=500ms
